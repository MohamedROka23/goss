rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid))
            .data.role in ['admin', 'super'];
    }

    function hasRole(role) {
      return isAdmin() && adminDoc().data.role == role;
    }

    // A team member may act when they carry the named panel permission. The
    // super admin bypasses every permission gate.
    function hasPerm(perm) {
      return hasRole('super') ||
        (isAdmin() &&
          adminDoc().data.permissions is list &&
          perm in adminDoc().data.permissions);
    }

    // No register code was ever allowed to grant admin: self-registration is
    // provisioning zero (a bare delegate). Everything else comes from a super.

    // A product must always live inside a section that actually exists.
    //
    // Without this, a write can name a category that was never created (or a
    // typo'd id) and the product then shows up under "All" while being
    // unreachable from its own section — the section filter compares
    // `product.category == category.id`, so a mismatch silently hides it.
    //
    // `get()` costs one document read per validation, which is acceptable for
    // a catalogue write and is what makes the guarantee enforceable rather than
    // merely conventional.
    function hasValidCategory() {
      return 'category' in request.resource.data &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        exists(/databases/$(database)/documents/categories/$(request.resource.data.category));
    }

    // True while the given account still exists as a team member AND still
    // carries the `chat` permission. Used to prune support-device keys of
    // members who have been removed or had `chat` revoked — their key must stop
    // being a valid recipient for newly sealed conversations.
    function stillChatStaff(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid)) &&
        (get(/databases/$(database)/documents/admins/$(uid)).data.role in
          ['admin', 'super']) &&
        get(/databases/$(database)/documents/admins/$(uid))
            .data.permissions is list &&
        'chat' in get(/databases/$(database)/documents/admins/$(uid))
            .data.permissions;
    }

    // Public catalogue. Supplier cost prices MUST NOT live here: this rule
    // grants unauthenticated read of the whole document, and Firestore rules
    // cannot redact individual fields. Costs live in /product_costs/{id} below,
    // which only the quotes panel can read.
match /products/{id} {
      allow read: if true;
      // Catalogue management lives inside the Price quotes (Quotes) panel, so the
      // same permission that opens the panel also guards its writes.
      //
      // `hasValidCategory()` is mandatory: a product can only be created or
      // moved into a section that really exists, so nothing can end up orphaned
      // and invisible in the section filter.
      allow create: if hasPerm('quotes') &&
        !('costPrice' in request.resource.data) &&
        hasValidCategory();
      allow update: if hasPerm('quotes') &&
        !('costPrice' in request.resource.data) &&
        hasValidCategory();
      allow delete: if hasPerm('quotes');
    }

    // Supplier cost + margin, split out of /products so the public catalogue
    // read above never exposes the shop's buy-in price.
    match /product_costs/{id} {
      allow read, write: if hasPerm('quotes');
    }

    match /categories/{id} {
      allow read: if true;
      // A section must carry both display names, otherwise the catalogue filter
      // renders a blank entry that nobody can pick.
      allow create, update: if hasPerm('quotes') &&
        request.resource.data.en is string &&
        request.resource.data.en.size() > 0 &&
        request.resource.data.ar is string &&
        request.resource.data.ar.size() > 0;
      allow delete: if hasPerm('quotes');
    }

    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if hasPerm('quotes');
    }

    match /admins/{uid} {
      // A member always reads their OWN document so role/permission changes
      // made by the owner propagate to every signed-in device live; team
      // admins may read the full list to manage accounts.
      allow read: if isAdmin() ||
        (signedIn() && uid == request.auth.uid);
      // Self-registration is disabled: a brand-new auth account has NO /admins
      // document, so it can never appear in the team panel. Real accounts are
      // provisioned by a team member through the team panel only.
      // Team members with the admins (team) panel manage accounts exactly like
      // the HTTP server: they may create admin/delegate accounts but can never
      // mint a super admin or write the protected fields.
      allow create: if hasPerm('team') &&
        !request.resource.data.keys().hasAny([
          'registerCode', 'approved', 'uid'
        ]) &&
        request.resource.data.role in ['delegate', 'admin'];
      // The owner/super admin provisions and maintains members without limits;
      // a team-panel member may update only non-super accounts and can never
      // promote anyone (including themselves) to super. Protected fields are
      // checked over the before/after diff: for update() the result data keeps
      // every field already present on the document.
      allow update: if hasRole('super') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'registerCode', 'approved', 'uid'
        ]);
      allow update: if hasPerm('team') &&
        resource.data.role != 'super' &&
        request.resource.data.role in ['delegate', 'admin'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'registerCode', 'approved', 'uid'
        ]);
      // REVOKE (tombstone). Removing a member does not delete the document: it
      // rewrites the role to `revoked`, which is in no allow-list above and so
      // strips every permission the moment this write lands — the device that
      // was signed in re-reads this same document and signs itself out. Keeping
      // the row also keeps the e-mail reserved so the address cannot be
      // re-registered by someone else.
      //
      // It is deliberately a one-way door: the source role must not already be
      // `revoked` and the target must be exactly `revoked`, so no rule anywhere
      // can move an account back off the tombstone (restoring it is a fresh
      // provisioning through `create`). Clearing the permission list in the same
      // write guarantees a tombstone can never carry live panels.
      allow update: if (hasRole('super') || hasPerm('team')) &&
        resource.data.role != 'revoked' &&
        request.resource.data.role == 'revoked' &&
        request.resource.data.permissions.size() == 0;
      allow delete: if hasRole('super') ||
        (hasPerm('team') && resource.data.role != 'super');
    }

    match /requests/{id} {
      // A customer may only ever CREATE a request in its initial state. Without
      // the field/state pins below, a modified client could submit an order
      // already marked confirmed/archived/converted, with a forged orderNo
      // (bypassing the counter) or a forged uid.
      //
      // The membership tests use `!('field' in data)`, NOT `data.field == false`:
      // reading an absent field is a runtime ERROR in Firestore rules, and an
      // error anywhere in the `&&` chain denies the whole write — which would
      // stop customers from submitting any order at all.
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        !('archived' in request.resource.data) &&
        !('converted' in request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'company', 'name', 'phone', 'email', 'notes', 'items', 'status',
          'type', 'customerId', 'origin', 'destination', 'orderNo', 'vat',
          'createdAt', 'uid'
        ]) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() <= 200;
      // Team reads only with the requests panel; customers only their own.
      allow read: if (isAdmin() && hasPerm('requests')) ||
        (signedIn() && resource.data.customerId == request.auth.uid);
      // Team manages the full lifecycle. A team member with the requests panel
      // can do the same on the HTTP backend, so the panel permission — not the
      // bare role — is the gate here too.
      allow update: if isAdmin() && hasPerm('requests');
      // Customers may only (a) answer the delivery question and (b) archive
      // their own order. Everything else — items, prices, VAT, orderNo,
      // converted, createdAt — is admin-only, enforced over the before/after
      // diff so a hand-crafted REST call cannot bypass the client checks in
      // firestore_backend.dart.
      //
      // The accepted source states mirror my_orders_screen exactly: the answer
      // buttons appear once the order is out for delivery or already delivered.
      // Answering from any earlier stage is refused, so a customer can no longer
      // jump a `new` order straight to `confirmed`.
      //
      // `!(x in list)` is NOT negated membership here: Firestore's `!` binds
      // tighter than `in`, so it must be written as
      // `!(resource.data.status in [...])` explicitly, which is what is used
      // below. Answering the same question twice is refused by the frozen
      // check, so the terminal state cannot be rewritten.
      allow update: if signedIn() &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status', 'archived']) &&
        (!(request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['status'])) ||
          (resource.data.status in ['delivering', 'delivered'] &&
            !(resource.data.status in ['confirmed', 'rejected']) &&
            request.resource.data.status in ['confirmed', 'rejected']));
      allow delete: if isAdmin() && hasPerm('requests');
    }

    match /purchases/{id} {
      // Gated by the PANEL PERMISSION (not by role) so an owner-granted
      // delegate/team member can actually open the data they were given.
      allow read, write: if hasPerm('purchases');
    }

    match /expenses/{id} {
      allow read, write: if hasPerm('expenses');
    }

    match /journal/{id} {
      allow read, write: if hasPerm('accounting');
    }

    match /payments/{id} {
      allow read, write: if hasPerm('accounting');
    }

    match /customer_tokens/{cid} {
      allow read, write: if signedIn() && cid == request.auth.uid;
    }

    // Sequential counters used to generate operation codes (GOSSTS01,
    // GOSSTT001, GOSSTP0001). Any signed-in user may bump the counter so both
    // customers (quotes/supply) and admins (purchases) can create documents.
    // Only a single numeric `value` field is writable; value is never deleted.
    match /counters/{key} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.resource.data is map &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value is int &&
        request.resource.data.value >= 0;
      allow delete: if false;
    }

    match /admin_tokens/{uid} {
      // Bound to the caller (same as customer_tokens below). Without this, any
      // account with a team role could overwrite another device's push token.
      allow read: if isAdmin();
      allow write: if isAdmin() && uid == request.auth.uid;
    }

    // E2E support chat (شات الدعم المشفّر). All message bodies in Firestore
    // are ciphertext; these rules only enforce identity + role boundaries.
    match /chat_public_keys/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.publicB64 is string &&
        request.resource.data.publicB64.size() <= 2048;
    }

    match /chat_staff_keys/{uid} {
      // Public keys are public (needed so customers can seal a conversation to
      // every support device). A device can only enroll as a SUPPORT endpoint
      // while the account holds the `chat` permission — the permission is
      // granted by the owner/admin through the team panel. Because every read /
      // enrollment re-resolves the admin document live, revoking the permission
      // cuts the device off immediately (until then the enrollment stays open).
      allow read: if signedIn();
      allow create, update: if hasPerm('chat') &&
        uid == request.auth.uid &&
        request.resource.data.publicB64 is string &&
        request.resource.data.publicB64.size() <= 2048;
      // Without this, a removed member's public key stayed in the collection
      // forever and every future conversation was sealed to their device. A
      // member may drop their own enrollment; a team member may prune any
      // device that no longer holds the `chat` permission.
      allow delete: if (signedIn() && uid == request.auth.uid) ||
        (hasPerm('chat') && !stillChatStaff(uid));
    }

    match /chat_conversations/{id} {
      function requestedParticipant(uid) {
        return signedIn() &&
          request.resource.data.participants is list &&
          uid in request.resource.data.participants;
      }
      allow read: if hasPerm('chat') ||
        (signedIn() && request.auth.uid == resource.data.customerId);
      allow create: if requestedParticipant(request.auth.uid) &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.ephPubB64 is string &&
        request.resource.data.wrappedKeys is map;
      // Team updates the lifecycle only when they still hold the `chat`
      // permission (live-checked each request), so revoking it cuts the device
      // off immediately. The customer identity and the sealed key boxes are
      // immutable (created once, never re-wrapped). The guard is expressed over
      // the *diff* between before/after, because for update() the result data
      // contains every preserved field of the existing document.
      allow update: if hasPerm('chat') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'customerId', 'participants', 'wrappedKeys',
          'wrapNonces', 'wrapMacs', 'ephPubB64'
        ]);
      // A participant (the customer) may only move their own conversation's
      // lifecycle: close it at any time (including cancelling a pending
      // request), or RE-OPEN it after it was closed. They can never promote a
      // pending conversation to open by themselves — only a team member can.
      // Identity, key boxes, timestamps and the customer name stay immutable.
      allow update: if signedIn() &&
        request.auth.uid == resource.data.customerId &&
        request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'closed' ||
          (request.resource.data.status == 'open' &&
            resource.data.status == 'closed'));
      // Deleting a conversation (and its messages) is a team action. The
      // messages are protected by the subcollection rules below.
      allow delete: if hasPerm('chat');
    }

    match /chat_conversations/{id}/messages/{msgId} {
      function conversation() {
        return get(/databases/$(database)/documents/chat_conversations/$(id));
      }
      // Read access is re-derived on every request instead of trusting the
      // static participants list: a participant stamped at creation time who
      // has since been removed from the team (or had `chat` revoked) must lose
      // access to both the ciphertext and the key.
      //
      // `exists` is a PROPERTY on a document snapshot, not a function — calling
      // it as `exists()` makes the whole expression an error, which Firestore
      // treats as "deny", silently cutting the customer out of their own chat.
      function mayRead() {
        return hasPerm('chat') ||
          (signedIn() &&
            conversation().exists &&
            (request.auth.uid == conversation().data.customerId ||
              (stillChatStaff(request.auth.uid) &&
                conversation().data.participants is list &&
                request.auth.uid in conversation().data.participants)));
      }
      allow read: if mayRead();
      allow create: if mayRead() &&
        conversation().data.status == 'open' &&
        request.resource.data.senderUid == request.auth.uid &&
        // The role is derived from the live team record, never accepted from
        // the client — otherwise a customer could stamp its own message
        // `admin` and have it render as an official support reply.
        request.resource.data.senderRole ==
          (stillChatStaff(request.auth.uid) ? 'admin' : 'customer') &&
        request.resource.data.kind in ['text', 'image'] &&
        request.resource.data.data is string &&
        request.resource.data.data.size() <= 1048576 &&
        (!('mediaData' in request.resource.data) ||
          (request.resource.data.mediaData is string &&
            request.resource.data.mediaData.size() <= 1048576));
      allow update, delete: if hasPerm('chat');
    }

    // Catch-all deny: any collection not listed above is inaccessible.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}