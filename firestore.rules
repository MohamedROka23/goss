rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is anyone who has an account doc under /admins/{auth.uid}.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      // Any existing admin can read, update or remove member accounts.
      // A brand-new account may only create its own document while proving
      // the admin registration code (the app removes the code right after).
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        (isAdmin() || (
          request.auth.uid == uid &&
          request.resource.data.role == 'admin' &&
          request.resource.data.registerCode == 'GOSST@admin'));
      allow update, delete: if isAdmin();
    }

    // Requests are owned by the (anonymous) customer that created them.
    match /requests/{id} {
      allow create: if request.auth != null &&
        request.resource.data.customerId == request.auth.uid;
      allow read, update, delete: if isAdmin() ||
        (request.auth != null && resource.data.customerId == request.auth.uid);
    }

    match /purchases/{id} {
      allow read, write: if isAdmin();
    }

    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // A customer may update only their own FCM token doc.
    match /customer_tokens/{cid} {
      allow read, write: if request.auth != null && cid == request.auth.uid;
    }

    match /admin_tokens/{uid} {
      allow read, write: if isAdmin();
    }
  }
}